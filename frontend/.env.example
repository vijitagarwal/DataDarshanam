# Public Supabase project configuration (the anon key is safe for browser use
# only while the project RLS policies are enabled).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this key with NEXT_PUBLIC_ or expose it to clients.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-side AI providers used by query insights and document flows.
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=

# Optional server-side embedding settings; application defaults are used when blank.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_EMBEDDING_VERSION=google-gemini/gemini-embedding-001/retrieval-v1/dim-768/norm-l2-v1
GEMINI_EMBEDDING_MAX_INPUT_TOKENS=2048
GEMINI_EMBEDDING_MAX_REQUEST_TOKENS=16384

# Keep disabled until non-production Supabase and provider verification is complete.
DOCUMENT_RAG_ANSWERS_ENABLED=false
