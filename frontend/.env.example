NEXT_PUBLIC_API_URL=https://your-backend-api-url
NEXT_PUBLIC_APP_NAME=dataदर्शनम्

# Supabase public configuration. The anon key is safe for browser use only
# when database RLS policies are enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only. Never expose or prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-only Gemini embedding configuration. Do not expose these values to
# browser code or prefix them with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_EMBEDDING_VERSION=google-gemini/gemini-embedding-001/retrieval-v1/dim-768/norm-l2-v1
GEMINI_EMBEDDING_MAX_INPUT_TOKENS=2048
GEMINI_EMBEDDING_MAX_REQUEST_TOKENS=16384

# Keep disabled until non-production Supabase, Gemini, Groq, and deployment
# verification has passed. This is server-only; do not use a NEXT_PUBLIC_ prefix.
DOCUMENT_RAG_ANSWERS_ENABLED=false
